# Copie este arquivo para .env e preencha APENAS UM provedor.
# Nunca commite o arquivo .env real.

# Provedor: gemini | groq | openrouter | ollama | offline
LLM_PROVIDER=groq

# Modelo sugerido por provedor (camada gratuita):
#   groq       -> llama-3.3-70b-versatile
#   gemini     -> gemini-2.0-flash
#   openrouter -> meta-llama/llama-3.3-70b-instruct:free
#   ollama     -> llama3.1:8b
LLM_MODEL=llama-3.3-70b-versatile

GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
